<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal">

        <TextView style="@style/WidgetTab" android:background="@drawable/tab_selected" android:text="Traballo" />
        <TextView style="@style/WidgetTab" android:layout_marginStart="2dp" android:background="@drawable/tab_normal" android:text="Persoal" />
        <TextView style="@style/WidgetTab" android:layout_marginStart="2dp" android:background="@drawable/tab_normal" android:text="Outros" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/postit"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView style="@style/PreviewRow" android:drawableStart="@drawable/dot_red" android:text="Enviar o informe" />
        <TextView style="@style/PreviewRow" android:drawableStart="@drawable/dot_yellow" android:text="Chamar ao cliente" />
        <TextView style="@style/PreviewRow" android:drawableStart="@drawable/dot_green" android:text="Ordenar o correo" />
    </LinearLayout>
</LinearLayout>
