<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotasApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SizePickerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TaskEditActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.NotasApp.Dialog"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".TaskActionActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.NotasApp.Transparent" />

        <service
            android:name=".NotasWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver android:name=".NotasWidget2x2" android:exported="false" android:label="Notas 2x2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_2x2" />
        </receiver>
        <receiver android:name=".NotasWidget2x3" android:exported="false" android:label="Notas 2x3">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_2x3" />
        </receiver>
        <receiver android:name=".NotasWidget3x2" android:exported="false" android:label="Notas 3x2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_3x2" />
        </receiver>
        <receiver android:name=".NotasWidget3x3" android:exported="false" android:label="Notas 3x3">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_3x3" />
        </receiver>
        <receiver android:name=".NotasWidget3x4" android:exported="false" android:label="Notas 3x4">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_3x4" />
        </receiver>
    </application>
</manifest>
